# System user access token (ads_management/ads_read + business_management on this pixel).
# Used by scripts/dataset-quality.mjs locally, and by src/pages/api/submit-form.ts
# (Meta Conversions API) — that one also needs to be set as a Vercel env var.
META_ACCESS_TOKEN=
DATASET_ID=821997303593699

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX). Public — exposed to the browser.
# Must also be set as a Vercel env var for the live site to track.
PUBLIC_GA_ID=

# Microsoft Clarity project ID. Public — exposed to the browser.
# Must also be set as a Vercel env var for the live site to track.
PUBLIC_CLARITY_ID=
