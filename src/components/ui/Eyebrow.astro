---
interface Props {
  class?: string;
  rotate?: string;
}

const { class: className = "", rotate = "-rotate-3" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-brand-sm bg-surface-dark px-3.5 py-2 font-brand-sans text-sm font-bold text-on-dark",
    rotate,
    className,
  ]}
>
  <slot />
</span>
