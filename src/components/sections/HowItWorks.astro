---
import Eyebrow from "../ui/Eyebrow.astro";
import PillButton from "../ui/PillButton.astro";

const steps = [
  {
    number: 1,
    title: "Napíšete mi",
    text: "Vyplníte krátký formulář s pár základními informacemi o vašem podnikání.",
  },
  {
    number: 2,
    title: "Připravím návrh",
    text: "Do 3 dnů dostanete konkrétní návrh webu na míru. Úplně zadarmo.",
  },
  {
    number: 3,
    title: "Dokončím web",
    text: "Pokud se vám návrh bude líbit, domluvíme se na spolupráci a web společně dokončíme.",
  },
];
---

<section class="w-full bg-frozen-water">
  <div class="mx-auto max-w-[940px] px-[clamp(20px,5vw,40px)] py-[clamp(56px,9vw,88px)]">
    <div class="mx-auto flex max-w-[820px] flex-col items-center gap-4 text-center">
      <Eyebrow>Jak to funguje</Eyebrow>
      <h2 class="font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
        Tři kroky <span class="text-blue-grey">k novému webu</span>
      </h2>
    </div>

    <div class="relative mt-[clamp(40px,7vw,64px)]">
      <div class="pointer-events-none absolute inset-x-[16%] top-9 h-px bg-surface-dark max-[860px]:hidden"></div>
      <div class="flex flex-wrap items-start justify-center gap-10">
        {
          steps.map((step) => (
            <div class="flex max-w-[320px] flex-1 basis-60 flex-col items-center gap-[18px] text-center">
              <div class="relative z-10 flex h-[72px] w-[72px] shrink-0 items-center justify-center rounded-full bg-surface-dark font-brand-heading text-[28px] font-extrabold text-on-dark">
                {step.number}
              </div>
              <h3 class="font-brand-heading text-lg font-semibold text-heading">{step.title}</h3>
              <p class="font-brand-sans text-[clamp(15px,3vw,16px)] leading-normal text-body">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-[clamp(36px,6.5vw,56px)] flex justify-center">
      <PillButton variant="primary" size="md">Chci návrh webu zdarma</PillButton>
    </div>
  </div>
</section>
