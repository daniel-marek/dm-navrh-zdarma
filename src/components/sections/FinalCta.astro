---
import PillButton from "../ui/PillButton.astro";
---

<section class="w-full bg-surface-page">
  <div class="mx-auto max-w-[1080px] px-[clamp(20px,5vw,40px)] pb-[clamp(56px,9vw,88px)]">
    <div class="mx-auto box-border flex flex-col items-center gap-6 rounded-brand-lg bg-frozen-water px-[clamp(22px,5vw,48px)] py-[clamp(40px,7vw,64px)] text-center shadow-brand-sm">
      <h2 class="font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
        Chcete web, který<br /><span class="text-blue-grey">přivádí zákazníky?</span>
      </h2>
      <p class="max-w-[660px] text-balance font-brand-sans text-[clamp(17px,2.6vw,19px)] font-medium leading-relaxed text-body">
        <b>Klikněte na tlačítko níže</b> a <b>vyplňte krátký formulář o svém podnikání</b>.
        Ozvu se vám a připravím návrh webu zdarma. Pokud se vám bude líbit, domluvíme se
        na realizaci.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-[clamp(16px,3.5vw,36px)]">
        <PillButton variant="primary" size="md">Chci návrh webu zdarma</PillButton>
        <span class="inline-flex items-center gap-2.5 font-brand-sans text-[clamp(14px,2.8vw,16px)] font-semibold text-[#F17002]">
          <span
            class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#F17002]"
            style="animation: brand-pulse 1.8s ease-in-out infinite"
          ></span>
          Ještě 2 volná místa tento měsíc
        </span>
      </div>
    </div>
  </div>
</section>
