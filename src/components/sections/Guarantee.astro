---

<section class="w-full bg-frozen-water">
  <div class="mx-auto flex max-w-[820px] flex-col items-center gap-5 px-[clamp(20px,5vw,40px)] pt-[clamp(56px,9vw,88px)] pb-10 text-center">
    <div class="relative flex h-[150px] w-[150px] items-center justify-center">
      <svg viewBox="0 0 150 150" class="absolute inset-0 h-full w-full" style="animation: brand-spin 14s linear infinite" aria-hidden="true">
        <defs>
          <path id="garance-ring" d="M75,75 m-64,0 a64,64 0 1,1 128,0 a64,64 0 1,1 -128,0"></path>
        </defs>
        <text class="font-brand-sans text-xs font-extrabold uppercase fill-heading" style="letter-spacing: 4.9px">
          <textPath href="#garance-ring" startOffset="4">Garance • Garance • Garance •</textPath>
        </text>
      </svg>
      <div class="flex h-24 w-24 items-center justify-center rounded-full bg-chartreuse">
        <img src="/check-mark.webp" alt="" width="44" height="44" class="block h-11 w-11 object-contain" />
      </div>
    </div>

    <h2 class="font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
      100% garance<br />bez rizika
    </h2>
    <p class="max-w-[560px] text-balance font-brand-sans text-[clamp(18px,3.4vw,22px)] font-semibold leading-normal text-heading">
      Pokud se vám návrh webu nebude líbit, nic neplatíte!
    </p>
    <img
      src="/photos/garance-daniel.jpg"
      alt="Daniel Marek"
      class="mt-4 aspect-square w-[420px] max-w-full rounded-[20px] object-cover shadow-brand-sm"
    />
  </div>
</section>
