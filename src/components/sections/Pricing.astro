---
import Eyebrow from "../ui/Eyebrow.astro";
---

<section class="w-full bg-frozen-water">
  <div class="mx-auto flex max-w-[820px] flex-col items-center gap-6 px-[clamp(20px,5vw,40px)] pt-10 pb-[clamp(56px,9vw,88px)] text-center">
    <Eyebrow>Cena</Eyebrow>
    <h2 class="text-balance font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
      „A kolik zaplatím, když se mi <br class="max-[780px]:hidden" />návrh bude <span class="text-blue-grey">líbit?</span>“
    </h2>
    <p class="max-w-[560px] text-balance font-brand-sans text-[clamp(18px,3.4vw,22px)] font-semibold leading-normal text-body">
      Dobrá otázka. Zakládám si na férovém přístupu, konečnou částku znáte předem a
      žádné skryté poplatky u mě nečekejte.
    </p>
    <div class="gradient-card max-w-[680px] rounded-brand-lg px-[clamp(22px,5vw,36px)] py-[clamp(24px,5vw,32px)]">
      <p class="font-brand-sans text-[clamp(18px,3.4vw,22px)] font-bold leading-normal text-ink">
        Cena webu se pohybuje <span class="whitespace-nowrap">od <span class="text-blue-grey">14 000 Kč</span> do <span class="text-blue-grey">20 000 Kč</span></span>, podle rozsahu a
        náročnosti projektu.
      </p>
    </div>
  </div>
</section>
