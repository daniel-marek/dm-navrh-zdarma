---
const problems = [
  {
    title: "Ceny agentur vás děsí",
    text: "Agentura si účtuje desítky tisíc korun a na první návrh vás nechá týdny čekat.",
  },
  {
    title: "Nevíte, co za peníze dostanete",
    text: "Bez konkrétního návrhu předem nemáte jistotu, jak bude web vypadat ani jestli se vám bude líbit.",
  },
  {
    title: "Bojíte se zbytečné investice",
    text: "Investujete do webu a nakonec vám nepřinese jediného nového zákazníka.",
  },
  {
    title: "Nemáte na to čas",
    text: "Chcete, aby to za vás někdo vzal a udělal pořádně, aniž byste museli cokoliv řešit.",
  },
];
---

<section class="w-full bg-frozen-water">
  <div class="mx-auto max-w-[1040px] px-[clamp(20px,5vw,40px)] py-[clamp(56px,9vw,88px)]">
    <div class="mx-auto flex max-w-[820px] flex-col items-center gap-4 text-center">
      <h2 class="font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
        Je tato <span class="text-blue-grey">nabídka</span> přesně pro vás?
      </h2>
      <p class="max-w-[520px] text-[clamp(16px,3.2vw,20px)] text-body">
        Podnikáte, ale váš web tomu neodpovídá — buď žádný nemáte, nebo vám dělá víc
        škody než užitku.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-[400px] grid-cols-1 gap-4 sm:max-w-none sm:grid-cols-[repeat(2,minmax(0,400px))] sm:justify-center">
      {
        problems.map((item) => (
          <div class="gradient-card flex flex-col gap-3.5 rounded-brand-lg p-[clamp(22px,4vw,28px)]">
            <img src="/cross-mark.png" alt="" width="40" height="40" class="h-10 w-10" />
            <span class="font-brand-heading text-lg font-extrabold uppercase leading-tight text-heading">{item.title}</span>
            <span class="font-brand-sans text-sm font-semibold text-ink">{item.text}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
