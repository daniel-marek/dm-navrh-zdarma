---
import Eyebrow from "../ui/Eyebrow.astro";
import PillButton from "../ui/PillButton.astro";

const benefits = [
  { icon: "/handshake.png", text: "Platíte, jen když jste s výsledkem spokojeni.", dark: true },
  { icon: "/money-bag.png", text: "Zlomek ceny, kterou byste zaplatili agentuře.", dark: false },
  { icon: "/high-voltage.png", text: "Návrh do pár dní, ne týdnů čekání.", dark: true },
  { icon: "/magnet.png", text: "Web navržený tak, aby přiváděl nové zákazníky.", dark: false },
  { icon: "/shield.png", text: "Žádné riziko zbytečně vyhozených peněz.", dark: true },
  { icon: "/raising-hands.png", text: "Vy neřešíte vůbec nic, o všechno se postarám já.", dark: false },
];
---

<section class="w-full bg-surface-page">
  <div class="mx-auto max-w-[940px] px-[clamp(20px,5vw,40px)] py-[clamp(56px,9vw,88px)]">
    <div class="mx-auto flex max-w-[820px] flex-col items-center gap-4 text-center">
      <Eyebrow>Moje řešení</Eyebrow>
      <h2 class="font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
        Web <span class="text-blue-grey">uvidíte hotový</span>,<br />než za něj zaplatíte
      </h2>
      <p class="mt-4 max-w-[560px] text-[clamp(18px,3.6vw,24px)] font-extrabold text-heading">
        Žádná nabídka plná slibů a hezkých slov.
      </p>
      <p class="max-w-[560px] text-[clamp(16px,3.2vw,20px)] leading-normal text-body">
        Nejdřív vám připravím návrh webu na míru vaší firmě. Uvidíte, jak bude vypadat a
        fungovat, a teprve potom se rozhodnete, jestli do něj chcete jít.
      </p>
    </div>

    <div class="mt-[clamp(36px,6.5vw,56px)] grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        benefits.map((item) => (
          <div
            class:list={[
              "flex flex-col gap-3.5 rounded-brand-lg p-[clamp(22px,4vw,28px)] shadow-brand-sm",
              item.dark ? "bg-surface-dark" : "bg-surface-chip",
            ]}
          >
            <img src={item.icon} alt="" width="40" height="40" class="h-10 w-10" />
            <span class:list={["font-brand-heading text-xl font-semibold leading-[1.15]", item.dark ? "text-on-dark" : "text-heading"]}>
              {item.text}
            </span>
          </div>
        ))
      }
    </div>

    <div class="mt-[clamp(36px,6.5vw,56px)] flex justify-center">
      <PillButton variant="primary" size="md">Chci návrh webu zdarma</PillButton>
    </div>
  </div>
</section>
