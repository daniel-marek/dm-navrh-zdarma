---
import Eyebrow from "../ui/Eyebrow.astro";
import DecoArrow from "../ui/DecoArrow.astro";

const reviewImages = [
  { src: "/photos/recenze-1.png", rotate: "-rotate-2" },
  { src: "/photos/recenze-4.jpeg", rotate: "rotate-2" },
  { src: "/photos/recenze-3.jpeg", rotate: "rotate-2" },
  { src: "/photos/recenze-2.png", rotate: "-rotate-2" },
  { src: "/photos/recenze-5.jpeg", rotate: "-rotate-2" },
  { src: "/photos/recenze-6.jpeg", rotate: "rotate-2" },
];
---

<section class="w-full bg-surface-page">
  <div class="mx-auto max-w-[860px] px-[clamp(20px,5vw,40px)] py-[clamp(56px,9vw,88px)]">
    <div class="mx-auto flex max-w-[820px] flex-col items-center gap-4 text-center">
      <Eyebrow>Recenze</Eyebrow>
      <h2 class="font-brand-heading text-[clamp(34px,6.4vw,58px)] font-extrabold uppercase leading-[1.1] tracking-[-1px] text-heading">
        Jak moji práci <span class="text-blue-grey">hodnotí klienti</span>
      </h2>
    </div>

    <div class="mt-[clamp(28px,5.5vw,40px)] flex justify-center">
      <div class="flex items-center gap-4.5 rounded-2xl border border-space-indigo/12 bg-white px-6.5 py-4 shadow-brand-sm">
        <svg width="42" height="42" viewBox="0 0 48 48" aria-label="Google">
          <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-2.8-.5-4.1H24v7.8h12c-.2 2-1.5 5-4.4 7l6.7 5.2c4-3.7 6.8-9.1 6.8-15.9z"></path>
          <path fill="#34A853" d="M24 46c6.1 0 11.2-2 14.3-5.5l-6.7-5.2c-1.8 1.2-4.3 2.1-7.6 2.1-5.9 0-10.9-3.9-12.7-9.3l-7 5.4C7.9 41 15.3 46 24 46z"></path>
          <path fill="#FBBC05" d="M11.3 28.1c-.5-1.4-.8-2.9-.8-4.5s.3-3.1.8-4.5l-7-5.4C2.9 16.6 2 20.2 2 23.6s.9 7 2.3 9.9l7-5.4z"></path>
          <path fill="#EA4335" d="M24 9.9c4.2 0 7 1.8 8.6 3.3l6.1-6C34.9 3.7 30 1.6 24 1.6 15.3 1.6 7.9 6.6 4.3 13.7l7 5.4C13.1 13.8 18.1 9.9 24 9.9z"></path>
        </svg>
        <div class="flex flex-col items-start gap-0.5">
          <span class="font-brand-sans text-[15px] font-semibold text-body">Hodnocení na Google</span>
          <div class="flex items-center gap-2.5">
            <span class="font-brand-sans text-[26px] font-bold leading-none text-heading">5.0</span>
            <span class="text-[20px] leading-none tracking-[2px] text-space-indigo">★★★★★</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 items-start justify-items-center gap-8 sm:grid-cols-2">
      <div class="flex flex-col items-center gap-3">
        <h3 class="mb-4 -rotate-2 text-center font-brand-heading text-[clamp(24px,5vw,32px)] font-extrabold leading-[1.15] tracking-[-0.5px] text-balance text-heading">
          Co říká Honza<br />na naši spolupráci?
        </h3>
        <img
          src="/photos/honza-instagram.jpeg"
          alt="Instagram profil Honza Cestuje"
          class="gradient-card-cool block w-full max-w-[360px] -rotate-2 rounded-brand-lg"
        />
        <svg
          width="300"
          height="150"
          viewBox="0 0 300 150"
          fill="none"
          aria-hidden="true"
          class="mt-2 h-auto w-full max-w-[300px] self-end text-blue-grey max-[780px]:hidden"
          style="margin-right: clamp(-30px, -2vw, 0px)"
        >
          <path
            d="M18 12 C 22 56, 58 92, 92 82 C 118 74, 116 48, 92 48 C 66 48, 62 84, 100 100 C 128 118, 176 124, 200 100 C 222 78, 236 44, 258 44"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            pathLength="350"
            stroke-dasharray="10 10"></path>
          <path
            d="M265 35 C 273 39, 278 42, 283 44 C 278 46, 273 49, 265 53 C 268 47, 268 41, 265 35 Z"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <div class="hidden max-[780px]:block">
          <DecoArrow />
        </div>
      </div>
      <div class="aspect-[9/16] w-full max-w-[300px] shrink-0 justify-self-center rounded-[20px] bg-white shadow-brand-sm"></div>
    </div>

    <div class="mt-10 grid grid-cols-1 items-start gap-7 sm:grid-cols-2">
      {
        reviewImages.map((review) => (
          <img
            src={review.src}
            alt="Recenze na Google"
            class:list={["block w-full rounded-lg shadow-[0_4px_16px_rgba(26,27,65,.12)]", review.rotate]}
          />
        ))
      }
    </div>
  </div>
</section>
