---
export const prerender = true;

import "../styles/globals.css";
import barlowCondensed800 from "@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url";

import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import ProblemFit from "../components/sections/ProblemFit.astro";
import Solution from "../components/sections/Solution.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import WhyItPaysOff from "../components/sections/WhyItPaysOff.astro";
import CaseStudies from "../components/sections/CaseStudies.astro";
import Reviews from "../components/sections/Reviews.astro";
import Guarantee from "../components/sections/Guarantee.astro";
import Pricing from "../components/sections/Pricing.astro";
import About from "../components/sections/About.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import Faq from "../components/sections/Faq.astro";
import Footer from "../components/sections/Footer.astro";

import CheckerStrip from "../components/ui/CheckerStrip.astro";
import DecoArrow from "../components/ui/DecoArrow.astro";
import ContactFormModal from "../components/ui/ContactFormModal.astro";
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<link rel="preload" as="font" type="font/woff2" href={barlowCondensed800} crossorigin />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Návrh webu zdarma — Daniel Marek</title>
		<meta
			name="description"
			content="Nechte si zdarma a bez závazků navrhnout web pro vaši firmu. Zaplatíte, jen když budete s výsledkem spokojení."
		/>
	</head>
	<body class="bg-surface-page font-brand-sans">
		<Header />
		<Hero />
		<CheckerStrip />
		<ProblemFit />
		<Solution />
		<HowItWorks />
		<WhyItPaysOff />
		<DecoArrow />
		<CaseStudies />
		<DecoArrow flip />
		<Reviews />
		<CheckerStrip />
		<Guarantee />
		<Pricing />
		<CheckerStrip />
		<About />
		<FinalCta />
		<Faq />
		<Footer />
		<ContactFormModal />
	</body>
</html>
